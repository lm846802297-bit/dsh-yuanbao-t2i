{
  "name": "dsh-yuanbao-t2i",
  "version": "0.2.1",
  "description": "DSH 插件：腾讯元宝网页版文生图（yuanbao/t2i）。走 yuanbao.tencent.com 的 /api/chat SSE，从 type=replace 的 multimedias 取图，落盘为 PNG。自带 patchright，独立于 dsh-playwright-ag。自带浏览器端设置卡（Plugins 页可切换是否去水印/引擎）。",
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "yuanbao",
    "tencent",
    "text-to-image",
    "patchright"
  ],
  "license": "MIT",
  "dependencies": {
    "patchright": "1.62.3"
  }
}
